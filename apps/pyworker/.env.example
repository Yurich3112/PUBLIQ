# @file: apps/pyworker/.env.example
# @warning: DO NOT USE WEAK SECRETS IN PRODUCTION !!!

# ===[PYTHON WORKER]================================================================================
PYWORKER_HOST=127.0.0.1
PYWORKER_PORT=8010

# ---[AUTHENTICATION]-------------------------------------------------------------------------------
# Generated by pnpm pyworker:setup; server-only, never committed.
PYWORKER_API_TOKEN=rootsecret                                                              # <<< [!]

# ---[RUNTIME]--------------------------------------------------------------------------------------
PYWORKER_MAX_CONCURRENCY=4
PYWORKER_TASK_TIMEOUT_SECONDS=5
PYWORKER_LOG_LEVEL=info

# ---[HANDWRITTEN OCR & LOCAL OLLAMA (GEMMA 4 · APACHE 2.0)]----------------------------------------
# Loopback-only by default; set PYWORKER_ALLOW_PRIVATE_NETWORK=true for container-network Ollama.
PYWORKER_OLLAMA_URL=http://127.0.0.1:11434
PYWORKER_OCR_VLM_MODEL=gemma4:e4b
PYWORKER_OCR_VLM_FALLBACK_MODEL=gemma4:e2b
PYWORKER_OCR_TIMEOUT_SECONDS=120
PYWORKER_OCR_MAX_BYTES=20971520
PYWORKER_OCR_MAX_PAGES=10
PYWORKER_OCR_LOW_CONFIDENCE_THRESHOLD=0.80
PYWORKER_OCR_LEGIBILITY_MIN_AVG=0.60

# Optional UDIP models. Use absolute paths to local weights.
# UDIP_PII_MODEL_DIR=
# UDIP_OCR_DET_MODEL_DIR=
# UDIP_OCR_REC_MODEL_DIR=

# ===[DATABASE]=====================================================================================
# Optional, explicit PostgreSQL access. Disabled until a dedicated least-privilege account is provisioned.
# Remote PostgreSQL requires sslmode=verify-full; never use the Prisma ?schema= URL.
PYWORKER_DATABASE_URL=                                                                     # <<< [!]

# ===[QUEUE BRIDGE]=================================================================================
# Optional Node queue bridge. Both sides need the same separate private token.
# Optional bridge disabled. Generate a separate random secret before enabling.
# PYWORKER_QUEUE_URL=
# Optional bridge disabled. Generate a separate random secret before enabling.
# PYWORKER_QUEUE_TOKEN=
