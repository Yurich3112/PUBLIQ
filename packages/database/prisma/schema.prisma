generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

/// Application role catalogue; user assignments remain owned by Keycloak.
enum RoleCode {
  ROOT
  SADMIN
  ADMIN
  SYSTEM
  AUDITOR
  VIEWER
  USER
  GUEST
  LOGED
}

/// Stable identity of this application installation, independent of human/service users.
model System {
  uuid              String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key               String                   @unique
  createdAt         DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @db.Timestamptz(3)
  activeConfigUuid  String?                  @unique @map("active_config_uuid") @db.Uuid
  activeConfig      SystemConfigVersion?     @relation("ActiveSystemConfig", fields: [activeConfigUuid], references: [uuid], onDelete: Restrict)
  configVersions    SystemConfigVersion[]    @relation("SystemConfigVersions")
  configActivations SystemConfigActivation[]

  @@map("system")
}

/// Local role vocabulary only; catalogue entries do not grant permissions.
model Role {
  uuid      String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code      RoleCode @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("role")
}

/// Human identity references belong to Keycloak. SYSTEM is an internal audit actor without login.
/// All local primary keys are generated by PostgreSQL uuidv7(). Provider subjects are external.
model User {
  uuid              String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Verified Keycloak sub for human users; absent only for the internal SYSTEM actor.
  keycloakUuid      String?                  @unique @db.Uuid
  systemKey         String?                  @unique @map("system_key") @db.VarChar(80)
  createdAt         DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @db.Timestamptz(3)
  sessions          Session[]
  accounts          Account[]
  conversations     ChatConversation[]
  updatedLlmSettings LlmSettings[]
  createdLlmPrompts LlmPromptVersion[]
  createdFiles      File[]                   @relation("FileCreatedBy")
  updatedFiles      File[]                   @relation("FileUpdatedBy")
  fileVersions      FileVersion[]            @relation("FileVersionCreatedBy")
  createdTags       Tag[]                    @relation("TagCreatedBy")
  updatedTags       Tag[]                    @relation("TagUpdatedBy")
  createdProducts   Product[]                @relation("ProductCreatedBy")
  updatedProducts   Product[]                @relation("ProductUpdatedBy")
  createdConfigs    SystemConfigVersion[]    @relation("ConfigCreatedBy")
  updatedConfigs    SystemConfigVersion[]    @relation("ConfigUpdatedBy")
  publishedConfigs  SystemConfigVersion[]    @relation("ConfigPublishedBy")
  archivedConfigs   SystemConfigVersion[]    @relation("ConfigArchivedBy")
  configActivations SystemConfigActivation[]
  assignedUdipCases UdipCase[]               @relation("UdipCaseAssignee")
  createdUdipCases  UdipCase[]               @relation("UdipCaseCreatedBy")
  updatedUdipCases  UdipCase[]               @relation("UdipCaseUpdatedBy")

  @@map("user")
}

enum ChatMode {
  instant
  thinking
}

model LlmSettings {
  uuid             String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key              String             @unique @db.VarChar(32)
  activePromptUuid String             @unique @map("active_prompt_uuid") @db.Uuid
  activePrompt     LlmPromptVersion   @relation("ActiveLlmPrompt", fields: [activePromptUuid], references: [uuid], onDelete: Restrict)
  versions         LlmPromptVersion[] @relation("LlmPromptVersions")
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedByUuid    String?            @map("updated_by") @db.Uuid
  updatedBy        User?              @relation(fields: [updatedByUuid], references: [uuid], onDelete: SetNull)

  @@index([updatedByUuid])
  @@map("llm_settings")
}

model LlmPromptVersion {
  uuid          String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  settingsUuid  String       @map("settings_uuid") @db.Uuid
  settings      LlmSettings  @relation("LlmPromptVersions", fields: [settingsUuid], references: [uuid], onDelete: Restrict)
  activeFor     LlmSettings? @relation("ActiveLlmPrompt")
  version       Int
  systemPrompt  String       @map("system_prompt")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  createdByUuid String?      @map("created_by") @db.Uuid
  createdBy     User?        @relation(fields: [createdByUuid], references: [uuid], onDelete: SetNull)

  @@unique([settingsUuid, version])
  @@index([createdByUuid])
  @@map("llm_prompt_version")
}

enum ChatMessageRole {
  user
  assistant
}

model ChatConversation {
  uuid      String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerUuid String        @map("owner_uuid") @db.Uuid
  owner     User          @relation(fields: [ownerUuid], references: [uuid], onDelete: Cascade)
  title     String        @db.VarChar(120)
  mode      ChatMode      @default(instant)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  messages  ChatMessage[]

  @@index([ownerUuid, updatedAt(sort: Desc), uuid(sort: Desc)])
  @@map("chat_conversation")
}

model ChatMessage {
  uuid             String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  requestUuid      String?          @unique @map("request_uuid") @db.Uuid
  conversationUuid String          @map("conversation_uuid") @db.Uuid
  conversation     ChatConversation @relation(fields: [conversationUuid], references: [uuid], onDelete: Cascade)
  role             ChatMessageRole
  mode             ChatMode
  content          String
  generation       Json?
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  attachments      ChatAttachment[]

  @@index([conversationUuid, uuid])
  @@map("chat_message")
}

model ChatAttachment {
  uuid        String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  messageUuid String      @map("message_uuid") @db.Uuid
  message     ChatMessage @relation(fields: [messageUuid], references: [uuid], onDelete: Cascade)
  name        String      @db.VarChar(255)
  size        Int
  content     Bytes

  @@index([messageUuid])
  @@map("chat_attachment")
}

enum SystemConfigStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model SystemConfigVersion {
  uuid                      String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  systemUuid                String                   @map("system_uuid") @db.Uuid
  system                    System                   @relation("SystemConfigVersions", fields: [systemUuid], references: [uuid], onDelete: Restrict)
  activeFor                 System?                  @relation("ActiveSystemConfig")
  version                   Int
  name                      String                   @db.VarChar(120)
  description               String                   @default("") @db.VarChar(2000)
  status                    SystemConfigStatus       @default(DRAFT)
  monitoringIntervalSeconds Int                      @default(60) @map("monitoring_interval_seconds")
  cleanupIntervalSeconds    Int                      @default(60) @map("cleanup_interval_seconds")
  historyRetentionDays      Int                      @default(7) @map("history_retention_days")
  queueRetryLimit           Int                      @default(3) @map("queue_retry_limit")
  slowResponseMs            Int                      @default(1500) @map("slow_response_ms")
  createdAt                 DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdByUuid             String                   @map("created_by") @db.Uuid
  updatedByUuid             String                   @map("updated_by") @db.Uuid
  publishedAt               DateTime?                @map("published_at") @db.Timestamptz(3)
  publishedByUuid           String?                  @map("published_by") @db.Uuid
  archivedAt                DateTime?                @map("archived_at") @db.Timestamptz(3)
  archivedByUuid            String?                  @map("archived_by") @db.Uuid
  createdBy                 User                     @relation("ConfigCreatedBy", fields: [createdByUuid], references: [uuid], onDelete: Restrict)
  updatedBy                 User                     @relation("ConfigUpdatedBy", fields: [updatedByUuid], references: [uuid], onDelete: Restrict)
  publishedBy               User?                    @relation("ConfigPublishedBy", fields: [publishedByUuid], references: [uuid], onDelete: Restrict)
  archivedBy                User?                    @relation("ConfigArchivedBy", fields: [archivedByUuid], references: [uuid], onDelete: Restrict)
  activations               SystemConfigActivation[]
  workers                   SystemConfigWorker[]

  @@unique([systemUuid, version])
  @@unique([systemUuid, uuid])
  @@index([systemUuid, createdAt])
  @@map("system_config_version")
}

model SystemConfigActivation {
  uuid               String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  systemUuid         String              @map("system_uuid") @db.Uuid
  system             System              @relation(fields: [systemUuid], references: [uuid], onDelete: Restrict)
  configUuid         String              @map("config_uuid") @db.Uuid
  config             SystemConfigVersion @relation(fields: [configUuid], references: [uuid], onDelete: Restrict)
  previousConfigUuid String?             @map("previous_config_uuid") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  createdByUuid      String              @map("created_by") @db.Uuid
  createdBy          User                @relation(fields: [createdByUuid], references: [uuid], onDelete: Restrict)

  @@index([systemUuid, createdAt])
  @@map("system_config_activation")
}

model SystemConfigWorker {
  uuid              String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workerKey         String               @unique @map("worker_key") @db.VarChar(120)
  appliedConfigUuid String?              @map("applied_config_uuid") @db.Uuid
  appliedConfig     SystemConfigVersion? @relation(fields: [appliedConfigUuid], references: [uuid], onDelete: Restrict)
  appliedAt         DateTime?            @map("applied_at") @db.Timestamptz(3)
  heartbeatAt       DateTime             @map("heartbeat_at") @db.Timestamptz(3)
  errorCode         String?              @map("error_code") @db.VarChar(40)

  @@map("system_config_worker")
}

/// Application session state linked to the local user UUID.
model Session {
  /// Successful extensions across all browser tabs; enforced atomically by the server.
  renewalCount Int      @default(0)
  uuid         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  token        String   @unique
  expiresAt    DateTime @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  ipAddress    String?
  userAgent    String?
  userUuid     String   @db.Uuid
  user         User     @relation(fields: [userUuid], references: [uuid], onDelete: Cascade)

  @@index([userUuid])
  @@index([expiresAt])
  @@map("session")
}

/// External provider identity and OIDC token state; no local profile or password.
model Account {
  uuid                  String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  subject               String    @db.Uuid
  provider              String
  userUuid              String    @db.Uuid
  user                  User      @relation(fields: [userUuid], references: [uuid], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([provider, subject])
  @@index([userUuid])
  @@map("account")
}

/// Expiring technical verification record, independent of Keycloak profile data.
model Verification {
  uuid       String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

enum FileStatus {
  active
  inactive
  pending_deletion
  softdelete
  pending_archiving
}

/// Logical file. The highest version number identifies its current content.
model File {
  deletingAt    DateTime?     @map("deleting_at") @db.Timestamptz(3)
  uuid          String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name          String
  status        FileStatus    @default(active)
  createdByUuid String        @map("created_by") @db.Uuid
  updatedByUuid String        @map("updated_by") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy     User          @relation("FileCreatedBy", fields: [createdByUuid], references: [uuid], onDelete: Restrict)
  updatedBy     User          @relation("FileUpdatedBy", fields: [updatedByUuid], references: [uuid], onDelete: Restrict)
  versions      FileVersion[]
  tags          FileTag[]
  products      Product[]     @relation("ProductImage")
  udipSourceCases UdipCase[]  @relation("UdipCaseSourceFile")
  udipDeptReplies UdipDepartmentQuery[] @relation("UdipDeptReplyFile")

  @@index([createdByUuid])
  @@index([updatedByUuid])
  @@map("file")
}

/// Content revision. Each revision refers to a separate UUID object key in the document bucket.
model FileVersion {
  fileName      String?  @map("file_name")
  uuid          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  fileUuid      String   @map("file_uuid") @db.Uuid
  version       Int
  seaweedUuid   String   @unique @map("seaweed_uuid") @db.Uuid
  size          BigInt
  createdByUuid String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  file          File     @relation(fields: [fileUuid], references: [uuid], onDelete: Restrict)
  createdBy     User     @relation("FileVersionCreatedBy", fields: [createdByUuid], references: [uuid], onDelete: Restrict)

  @@unique([fileUuid, version])
  @@index([createdByUuid])
  @@map("file_version")
}

/// Tag lifecycle, aligned with the catalog administration actions.
enum TagStatus {
  active
  inactive
  pending_archiving
  archived
  pending_deletion
  softdelete
}

model Tag {
  uuid          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name          String    @unique
  /// Validated #RRGGBB label color; existing tags receive a neutral slate default.
  color         String    @default("#64748B") @db.VarChar(7)
  /// Current lifecycle state. Existing tags remain active after migration.
  status        TagStatus @default(active)
  createdByUuid String    @map("created_by") @db.Uuid
  updatedByUuid String    @map("updated_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy     User      @relation("TagCreatedBy", fields: [createdByUuid], references: [uuid], onDelete: Restrict)
  updatedBy     User      @relation("TagUpdatedBy", fields: [updatedByUuid], references: [uuid], onDelete: Restrict)
  files         FileTag[]

  @@index([status, uuid])
  @@index([createdByUuid])
  @@index([updatedByUuid])
  @@map("tag")
}

model FileTag {
  fileUuid String @map("file_uuid") @db.Uuid
  tagUuid  String @map("tag_uuid") @db.Uuid
  file     File   @relation(fields: [fileUuid], references: [uuid], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagUuid], references: [uuid], onDelete: Cascade)

  @@id([fileUuid, tagUuid])
  @@index([tagUuid])
  @@map("file_tag")
}

/// Product lifecycle. Permanent deletion is an operation, not a persisted state.
enum ProductStatus {
  active
  inactive
  pending_archiving
  archived
  pending_deletion
  softdelete
}

/// Example business entity. Images are optional references to logical catalog files.
model Product {
  /// Generated by PostgreSQL, independent of external identifiers.
  uuid           String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Stable unique business code.
  code           String        @unique @db.VarChar(64)
  /// Human-readable name; different products may share it.
  name           String        @db.VarChar(255)
  /// Optional plain-text description.
  description    String?
  /// Current business lifecycle state.
  status         ProductStatus @default(active)
  /// Exact monetary value, with up to four fractional digits.
  price          Decimal       @db.Decimal(19, 4)
  /// Uppercase three-letter currency code.
  currency       String        @default("PLN") @db.VarChar(3)
  /// Optional image; removing a referenced file is restricted.
  imageFileUuid  String?       @map("image_file_uuid") @db.Uuid
  /// Verified local author, assigned by the server.
  createdByUuid  String        @map("created_by") @db.Uuid
  /// Verified local author of the latest change.
  updatedByUuid  String        @map("updated_by") @db.Uuid
  /// Creation timestamp.
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Last update timestamp maintained by Prisma.
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Last completed archival; retained after reactivation, null before first archival.
  lastArchivedAt DateTime?     @map("last_archived_at") @db.Timestamptz(3)
  imageFile      File?         @relation("ProductImage", fields: [imageFileUuid], references: [uuid], onDelete: Restrict)
  createdBy      User          @relation("ProductCreatedBy", fields: [createdByUuid], references: [uuid], onDelete: Restrict)
  updatedBy      User          @relation("ProductUpdatedBy", fields: [updatedByUuid], references: [uuid], onDelete: Restrict)

  @@index([createdByUuid])
  @@index([updatedByUuid])
  @@index([imageFileUuid])
  @@index([status, uuid])
  @@map("product")
}

enum MonitoredService {
  web
  backend
  database
  keycloak
  storage
  queue_worker
  pyworker
}

enum ServiceHealth {
  healthy
  degraded
  error
  unconfigured
}

/// Immutable minute-level observations, retained for at most seven days in reads.
model ServiceHealthSample {
  uuid       String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  service    MonitoredService
  status     ServiceHealth
  checkedAt  DateTime         @default(now()) @map("checked_at") @db.Timestamptz(3)
  responseMs Int?             @map("response_ms")
  httpStatus Int?             @map("http_status")
  /// Allowlisted reason code; never a URL, error stack or credential.
  reason     String           @db.VarChar(40)
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(3)

  @@unique([service, checkedAt])
  @@index([checkedAt])
  @@index([expiresAt])
  @@map("service_health_sample")
}

/// Transactional product/file history, written by PostgreSQL triggers.
/// Actor identity is retained after the original user or entity is deleted.
model ChangeHistory {
  uuid      String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  entity    String   @db.VarChar(32)
  entityUuid String  @map("entity_uuid") @db.Uuid
  parentUuid String? @map("parent_uuid") @db.Uuid
  actorUuid String?  @map("actor_uuid") @db.Uuid
  operation String  @db.VarChar(16)
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  before    Json?
  after     Json?

  @@index([entity, entityUuid, occurredAt])
  @@index([parentUuid, uuid])
  @@map("change_history")
}

/// UDIP request lifecycle statuses A–E displayed in the Clerk Calendar/Table.
enum UdipProcessStatus {
  /// A — Brak działań
  A
  /// B — Zapytania wysłane do wydziałów
  B
  /// C — Kwerenda (+ dodatkowa ilość dni, Art. 13 ust. 2 UDIP) / Wezwanie do doprecyzowania
  C
  /// D — Przygotowana odpowiedź
  D
  /// E — Odpowiedź wysłana do wnioskodawcy
  E
}

/// Routing path selected by the 2-Tier Knowledge Graph or AI Fallback.
enum UdipRoutingType {
  INTERNAL_DEPARTMENTS
  EXTERNAL_AUTHORITY
  CLARIFICATION_7D
}

/// Official BKS letter template category.
enum UdipTemplateType {
  MERIT_RESPONSE
  KWERENDA_EXTENSION
  CLARIFICATION_CALL
  EXTERNAL_REDIRECT
}

/// Per-department response state in the expandable Calendar Table sub-row.
enum UdipDeptStatus {
  PENDING
  REPLIED
  KWERENDA_REQUESTED
}

/// Public information request (UDIP) tracked in the BKS UM Bydgoszcz Calendar/Table ("SPRAWY DB").
model UdipCase {
  uuid                   String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Official BKS signature, e.g. BKS.IV.1431.599.2026.
  caseNumber             String                @unique @map("case_number") @db.VarChar(40)
  year                   Int
  sequenceNumber         Int                   @map("sequence_number")
  /// Kancelaria receipt number extracted from scan stamp, e.g. 3468/2026.
  registryNumber         String?               @map("registry_number") @db.VarChar(40)
  applicantName          String                @map("applicant_name") @db.VarChar(255)
  applicantContact       String?               @map("applicant_contact") @db.VarChar(255)
  subject                String
  receivedDate           DateTime              @map("received_date") @db.Timestamptz(3)
  deadlineDate           DateTime              @map("deadline_date") @db.Timestamptz(3)
  deadlineNote           String?               @map("deadline_note") @db.VarChar(160)
  answeredDate           DateTime?             @map("answered_date") @db.Timestamptz(3)
  assigneeName           String                @map("assignee_name") @db.VarChar(120)
  assigneeInitials       String                @map("assignee_initials") @db.VarChar(8)
  assigneeUserUuid       String?               @map("assignee_user_uuid") @db.Uuid
  processStatus          UdipProcessStatus     @default(A) @map("process_status")
  isMultiDepartment      Boolean               @default(false) @map("is_multi_department")
  sourceFileUuid         String?               @map("source_file_uuid") @db.Uuid
  sourceMode             String?               @map("source_mode") @db.VarChar(24)
  verifiedRequestText    String?               @map("verified_request_text")
  ocrConfidence          Float?                @map("ocr_confidence")
  matchedCaseNumber      String?               @map("matched_case_number") @db.VarChar(40)
  matchSimilarity        Float?                @map("match_similarity")
  routingType            UdipRoutingType       @default(INTERNAL_DEPARTMENTS) @map("routing_type")
  externalAuthorityName  String?               @map("external_authority_name") @db.VarChar(255)
  letterTemplateType     UdipTemplateType?     @map("letter_template_type")
  draftResponseText      String?               @map("draft_response_text")
  anonymizedResponseText String?               @map("anonymized_response_text")
  piiRedactionsCount     Int                   @default(0) @map("pii_redactions_count")
  addedToKnowledgeGraph  Boolean               @default(false) @map("added_to_knowledge_graph")
  createdByUuid          String?               @map("created_by") @db.Uuid
  updatedByUuid          String?               @map("updated_by") @db.Uuid
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  assigneeUser           User?                 @relation("UdipCaseAssignee", fields: [assigneeUserUuid], references: [uuid], onDelete: SetNull)
  sourceFile             File?                 @relation("UdipCaseSourceFile", fields: [sourceFileUuid], references: [uuid], onDelete: SetNull)
  createdBy              User?                 @relation("UdipCaseCreatedBy", fields: [createdByUuid], references: [uuid], onDelete: SetNull)
  updatedBy              User?                 @relation("UdipCaseUpdatedBy", fields: [updatedByUuid], references: [uuid], onDelete: SetNull)
  departmentQueries      UdipDepartmentQuery[]

  @@unique([year, sequenceNumber])
  @@index([year, receivedDate(sort: Asc), sequenceNumber(sort: Asc)])
  @@index([processStatus, deadlineDate])
  @@index([assigneeUserUuid])
  @@index([sourceFileUuid])
  @@index([createdByUuid])
  @@index([updatedByUuid])
  @@map("udip_case")
}

/// Expandable per-department inquiry sub-row attached to a UdipCase.
model UdipDepartmentQuery {
  uuid            String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  caseUuid        String         @map("case_uuid") @db.Uuid
  sortOrder       Int            @default(0) @map("sort_order")
  departmentName  String         @map("department_name") @db.VarChar(200)
  departmentEmail String?        @map("department_email") @db.VarChar(200)
  status          UdipDeptStatus @default(PENDING)
  questionText    String?        @map("question_text")
  /// Raw email reply text pasted directly by the clerk inside the Calendar Table row.
  replyText       String?        @map("reply_text")
  /// File name of an attached PDF/DOCX reply from the department.
  replyFileName   String?        @map("reply_file_name") @db.VarChar(255)
  replyFileUuid   String?        @map("reply_file_uuid") @db.Uuid
  sentAt          DateTime?      @map("sent_at") @db.Timestamptz(3)
  repliedAt       DateTime?      @map("replied_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  udipCase        UdipCase       @relation(fields: [caseUuid], references: [uuid], onDelete: Cascade)
  replyFile       File?          @relation("UdipDeptReplyFile", fields: [replyFileUuid], references: [uuid], onDelete: SetNull)

  @@index([caseUuid, sortOrder])
  @@index([replyFileUuid])
  @@map("udip_department_query")
}
